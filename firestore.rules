rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: products
    // Document ID: Auto-generated
    // Fields:
    //   - sku: string (required)
    //   - name: string (required)
    //   - slug: string (required)
    //   - description: string
    //   - basePrice: number (required)
    //   - salePrice: number | null
    //   - salePercentage: number | null
    //   - category: string (required)
    //   - subcategory: string
    //   - vertical: string
    //   - images: list
    //   - variants: list
    //   - attributes: map
    //   - tags: list
    //   - isActive: bool (required)
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //
    // Collection: users
    // Document ID: User UID
    // Fields:
    //   - email: string (required)
    //   - role: string (required, 'admin' or 'customer')
    //   - createdAt: timestamp
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email == "bra.rey.esteban@gmail.com" && request.auth.token.email_verified == true) ||
        (request.auth.token.email == "AdminArkane@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidProduct(data) {
      return data.sku is string && data.sku.size() > 0 && data.sku.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() < 200 &&
             data.basePrice is number && data.basePrice >= 0 &&
             data.category is string && data.category.size() > 0 && data.category.size() < 100 &&
             data.isActive is bool;
    }

    function isValidUser(data) {
      return data.email is string && data.email.size() > 0 && data.email.size() < 150 &&
             data.role in ['admin', 'customer'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /products/{productId} {
      // Anyone can read active products. Admins can read all products.
      allow read: if resource.data.isActive == true || isAdmin();
      
      // Only admins can create, update, or delete products
      allow create: if isAdmin() && hasRequiredFields(['sku', 'name', 'slug', 'basePrice', 'category', 'isActive']) && isValidProduct(request.resource.data);
      allow update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Users can read his own orders. Admins can read all orders.
      allow read: if isAuthenticated() && (resource.data.customerInfo.email == request.auth.token.email || isAdmin());
      
      // Users can create their own orders.
      allow create: if isAuthenticated() && request.resource.data.customerInfo.email == request.auth.token.email;
      
      // Only admins can update or delete orders
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      // Users can read their own profile. Admins can read all profiles.
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile, but cannot make themselves admin unless they are the bootstrap admin
      allow create: if isOwner(userId) && hasRequiredFields(['email', 'role']) && isValidUser(request.resource.data) && (request.resource.data.role == 'customer' || isAdmin());
      
      // Users can update their own profile, but cannot change their role. Admins can update any profile.
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == resource.data.role) || (isAdmin() && isValidUser(request.resource.data));
      
      allow delete: if isAdmin();
    }
  }
}
